# ─────────────────────────────────────────────────────────────────────────────
# B.A. Construction — variables d'environnement
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
# Ne committez jamais le fichier `.env` (il contient les secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# URL publique du site (utilisée pour les liens canoniques, le sitemap, les e-mails)
APP_URL=http://localhost:5173
# URL publique de l'API (derrière un reverse proxy en production)
API_URL=http://localhost:4000
# Activez si l'application est derrière Nginx / Traefik / Cloudflare
TRUST_PROXY=false

# ── Base de données ──────────────────────────────────────────────────────────
# Base locale (docker compose) :
DATABASE_URL=postgresql://ba_construction:ba_construction_dev@localhost:5432/ba_construction?schema=public
# Variables utilisées par docker-compose.yml pour initialiser le conteneur :
POSTGRES_USER=ba_construction
POSTGRES_PASSWORD=ba_construction_dev
POSTGRES_DB=ba_construction
POSTGRES_PORT=5432

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Secrets de signature JWT : 32 caractères minimum, valeurs différentes en prod.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-jwt-secret-a-remplacer-par-un-secret-aleatoire-64
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-a-remplacer-par-un-secret-aleatoire-64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Secret de signature du jeton CSRF (double submit cookie)
CSRF_SECRET=dev-csrf-secret-a-remplacer-par-un-secret-aleatoire-64

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Limitation de débit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# ── Fichiers ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
# Dossier public des médias (servi sur /uploads). Les pièces jointes des leads
# sont écrites dans storage/private et ne sont jamais servies publiquement.
UPLOAD_DIR=./storage/uploads

# ── E-mails (SMTP) ───────────────────────────────────────────────────────────
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=B.A. Construction <contact@ba-construction.tg>
MAIL_TO=contact@ba-construction.tg

# ── Comptes créés par le seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ba-construction.tg
SEED_ADMIN_PASSWORD=ChangeMe!2026Secure
SEED_EDITOR_EMAIL=editeur@ba-construction.tg
SEED_EDITOR_PASSWORD=ChangeMe!2026Editor

# ── Production (Render + Neon) ───────────────────────────────────────────────
# Voir docs/deployment.md. Rappel des valeurs spécifiques à la production :
#   NODE_ENV=production
#   TRUST_PROXY=true
#   APP_URL=https://<service>.onrender.com
#   API_URL=https://<service>.onrender.com
#   CORS_ORIGINS=https://<service>.onrender.com
#   DATABASE_URL=postgresql://…@…neon.tech/…?sslmode=require
# Les secrets JWT/CSRF doivent être différents et faire au moins 32 caractères.
